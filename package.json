{
  "name": "rdblog-explorer",
  "version": "1.0.0",
  "description": "ElvisPOS RDB LOG — Sales Transaction Explorer",
  "type": "module",
  "author": "",
  "license": "ISC",
  "scripts": {
    "dev:server": "bun run --watch server/index.ts",
    "dev:web": "vite",
    "dev": "bun run scripts/dev.ts",
    "build": "vite build",
    "start": "NODE_ENV=production bun run server/index.ts",
    "typecheck": "tsc --noEmit",
    "sidecar": "bun run scripts/build-sidecar.ts",
    "tauri": "tauri",
    "tauri:dev": "bun run sidecar && tauri dev",
    "tauri:build": "bun run sidecar && tauri build"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/bun": "^1.3.14",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "^6.0.7"
  },
  "private": true,
  "dependencies": {
    "@tauri-apps/api": "^2.11.1"
  }
}
